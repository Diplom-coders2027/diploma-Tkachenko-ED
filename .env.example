# ==============================================================================
# Пример переменных окружения (.env.example)
# Скопируйте этот файл в .env и укажите актуальные значения для локального запуска
# ==============================================================================

# Приложение
APP_ENV=development
APP_PORT=8080
APP_SECRET_KEY=change_me_in_local_env

# База данных (пример: PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=diploma_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Дополнительные сервисы
REDIS_HOST=localhost
REDIS_PORT=6379
