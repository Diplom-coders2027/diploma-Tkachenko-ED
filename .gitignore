# ==============================================================================
# .gitignore — Шаблон для выпускных квалификационных работ (дипломов)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Операционные системы
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.trash

# ------------------------------------------------------------------------------
# 2. Среды разработки (IDE) и текстовые редакторы
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, PyCharm, CLion, GoLand, WebStorm и др.)
.idea/
*.iws
*.iml
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Редакторы (Vim, Sublime, Emacs)
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
\#*\#
.\#*

# ------------------------------------------------------------------------------
# 3. Переменные окружения и секреты
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa
id_ecdsa
id_ed25519

# ------------------------------------------------------------------------------
# 4. Логи, дампы и временные файлы
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
*.dump
*.sql
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 5. Языки программирования и платформы
# ------------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node.js / TypeScript ---
node_modules/
jspm_packages/
.npm/
.yarn/
dist/
.next/
.nuxt/
.cache/
.turbo/
coverage/

# --- Go ---
/bin/
*.exe
*.test
*.prof
vendor/

# --- C / C++ ---
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exe
*.out
*.app
*.d
CMakeCache.txt
CMakeFiles/
!/Makefile
*.ninja
cmake-build-*/
build/
bin/

# --- Java / Kotlin / Gradle / Maven (дополнительно) ---
*.class
target/
.gradle/
build/

# ------------------------------------------------------------------------------
# 6. Документация: LaTeX
# ------------------------------------------------------------------------------
# Вспомогательные файлы сборки LaTeX
*.aux
*.bbl
*.bcf
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.glg
*.glo
*.gls
*.idx
*.ilg
*.ind
*.ist
*.lof
*.log
*.lot
*.maf
*.mtc*
*.nav
*.out
*.prv
*.ps
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.toc
*.vrb
_minted-*

# Артефакты компиляции PDF
# (Рекомендуется прикреплять итоговый PDF к GitHub Releases или сдавать в PR,
# раскомментируйте или добавьте исключение, если финальный PDF должен версионироваться)
*.pdf
!docs/templates/*.pdf

# ------------------------------------------------------------------------------
# 7. Документация: Microsoft Office / Word
# ------------------------------------------------------------------------------
~$*
~*.doc*
~*.xls*
~*.ppt*
*.tmp
